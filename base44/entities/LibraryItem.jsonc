{
  "name": "LibraryItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Jurnal",
        "Skripsi",
        "Thesis",
        "Disertasi",
        "Standar Teknis",
        "Modul",
        "Lainnya"
      ]
    },
    "author": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "tags": {
      "type": "string",
      "description": "Comma-separated tags"
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "Message",
  "type": "object",
  "properties": {
    "sender_id": {
      "type": "string",
      "description": "User ID pengirim"
    },
    "sender_name": {
      "type": "string",
      "description": "Nama pengirim (cache)"
    },
    "recipient_id": {
      "type": "string",
      "description": "User ID penerima"
    },
    "recipient_name": {
      "type": "string",
      "description": "Nama penerima (cache)"
    },
    "subject": {
      "type": "string",
      "description": "Subjek pesan"
    },
    "body": {
      "type": "string",
      "description": "Isi pesan"
    },
    "thread_id": {
      "type": "string",
      "description": "ID thread percakapan (gabungan sender+recipient IDs, sorted)"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Apakah sudah dibaca oleh penerima"
    },
    "parent_id": {
      "type": "string",
      "description": "ID pesan induk untuk reply (opsional)"
    }
  },
  "required": [
    "sender_id",
    "recipient_id",
    "body",
    "thread_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
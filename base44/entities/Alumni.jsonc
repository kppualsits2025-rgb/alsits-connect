{
  "name": "Alumni",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nama lengkap alumni"
    },
    "nrm_nrp": {
      "type": "string",
      "description": "Nomor Registrasi Mahasiswa / NRP"
    },
    "angkatan": {
      "type": "string",
      "description": "Kode angkatan (misal S32, S33, dst)"
    },
    "tahun_masuk": {
      "type": "number",
      "description": "Tahun masuk kuliah"
    },
    "tahun_lulus": {
      "type": "number",
      "description": "Tahun lulus"
    },
    "gelar": {
      "type": "string",
      "enum": [
        "S1",
        "S2",
        "S3"
      ],
      "default": "S1"
    },
    "bidang_keahlian": {
      "type": "string",
      "enum": [
        "Struktur",
        "Geoteknik",
        "Manajemen Konstruksi",
        "Transportasi",
        "Hidroteknik",
        "Lingkungan",
        "Lainnya"
      ],
      "description": "Bidang keahlian/peminatan"
    },
    "tanggal_lahir": {
      "type": "string",
      "description": "Tanggal lahir format YYYY-MM-DD"
    },
    "domisili_kota": {
      "type": "string",
      "description": "Kota domisili saat ini"
    },
    "domisili_negara": {
      "type": "string",
      "default": "Indonesia"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude untuk mapping"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude untuk mapping"
    },
    "perusahaan": {
      "type": "string",
      "description": "Nama perusahaan/instansi tempat bekerja"
    },
    "jabatan": {
      "type": "string",
      "description": "Jabatan saat ini"
    },
    "company_city": {
      "type": "string",
      "description": "Kota tempat perusahaan/usaha alumni beroperasi (field kota bersih)"
    },
    "bidang_industri": {
      "type": "string",
      "enum": [
        "Konstruksi",
        "Konsultan",
        "BUMN",
        "Pemerintahan",
        "Akademisi",
        "Wiraswasta",
        "Perbankan",
        "Energi",
        "Teknologi",
        "Lainnya"
      ]
    },
    "business_tags": {
      "type": "string",
      "description": "Keyword bisnis/produk/layanan yang ditawarkan, dipisah koma."
    },
    "email": {
      "type": "string",
      "description": "Email utama alumni"
    },
    "email2": {
      "type": "string",
      "description": "Email kedua alumni"
    },
    "telepon": {
      "type": "string",
      "description": "HP Utama"
    },
    "telepon2": {
      "type": "string",
      "description": "HP Kedua"
    },
    "telepon_kantor": {
      "type": "string",
      "description": "Telepon kantor"
    },
    "alamat_perusahaan": {
      "type": "string",
      "description": "Alamat perusahaan/kantor"
    },
    "linkedin": {
      "type": "string"
    },
    "photo_url": {
      "type": "string",
      "description": "URL foto profil"
    },
    "bio": {
      "type": "string",
      "description": "Ringkasan profil"
    },
    "status": {
      "type": "string",
      "description": "Status hidup: Aktif, Almarhum, Almarhumah",
      "default": "Aktif"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "source_web": {
      "type": "string",
      "description": "Web angkatan sumber data (misal s32its.id)"
    },
    "s32_member_id": {
      "type": "string",
      "description": "ID member di s32its.id untuk referensi"
    },
    "kegiatan_usaha": {
      "type": "string",
      "description": "JSON array dari BusinessProfile s32its.id"
    }
  },
  "required": [
    "full_name",
    "angkatan"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "data.email2": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "data.email2": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "data.email2": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}